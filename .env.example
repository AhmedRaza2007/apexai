# ==============================================================================
# AI Business Assistant - Environment Variables Configuration
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or secret keys to version control.
# ==============================================================================

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# AI Provider Configuration (OpenAI or compatible provider like Groq, OpenRouter, Ollama)
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: Specify the model (default is gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Optional: Set custom base URL for OpenAI-compatible APIs (e.g., https://api.groq.com/openai/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
