# ==============================================================================
# ApexAI Enterprise AI Suite - Environment Variables Configuration
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Database & Authentication (Supabase - Optional, Local fallback is included)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. AI Providers (Configure any or all; ApexAI includes offline Native fallback)
# ------------------------------------------------------------------------------
# Google Gemini API (Recommended for free high-speed models: gemini-1.5-flash, gemini-2.0-flash)
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter API (Recommended for free open-source models: Llama 3.3 70B, Mistral, Qwen)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenAI API (For gpt-4o, gpt-4o-mini)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 4. AI Video Studio Providers (Optional, high-definition studio fallback included)
# ------------------------------------------------------------------------------
# fal.ai Key (For Fast SVD / text-to-video diffusion)
FAL_KEY=your-fal-ai-key-here

# Replicate API Token
REPLICATE_API_TOKEN=your-replicate-api-token-here

# Hugging Face Access Token
HF_TOKEN=your-huggingface-token-here

# ------------------------------------------------------------------------------
# 5. Payment & Subscription Gateways (Optional, Sandbox activation included)
# ------------------------------------------------------------------------------
# Lemon Squeezy (Merchant of Record - supports Pakistan & 135+ countries globally)
LEMON_SQUEEZY_API_KEY=your-lemon-squeezy-api-key-here
LEMON_SQUEEZY_STORE_ID=your-store-id-here
LEMON_SQUEEZY_PRO_MONTHLY_VARIANT=your-variant-id-here
LEMON_SQUEEZY_PRO_YEARLY_VARIANT=your-variant-id-here
LEMON_SQUEEZY_BUSINESS_MONTHLY_VARIANT=your-variant-id-here
LEMON_SQUEEZY_BUSINESS_YEARLY_VARIANT=your-variant-id-here

# Stripe (For businesses with registered international entities)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret-here
STRIPE_PRO_MONTHLY_PRICE_ID=price_your-pro-monthly-price-id-here
STRIPE_PRO_YEARLY_PRICE_ID=price_your-pro-yearly-price-id-here
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_your-business-monthly-price-id-here
STRIPE_BUSINESS_YEARLY_PRICE_ID=price_your-business-yearly-price-id-here
